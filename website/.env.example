# ---------------------------------------------------------------------------
# Notebooks.com.ar — variables de entorno
#
# Copiar a `.env.local` para desarrollo, y cargar en Vercel → Settings →
# Environment Variables para producción.
#
# Las `NEXT_PUBLIC_*` **se hornean en el build**: cambiarlas en Vercel no tiene
# efecto hasta el próximo deploy. Es la trampa que más tiempo hace perder.
# ---------------------------------------------------------------------------

# --- Supabase ---------------------------------------------------------------

# La URL del proyecto y la anon key. La anon key es pública por diseño (respeta
# RLS); no es un secreto y puede estar en el bundle.
SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
SUPABASE_ANON_KEY=

# Las mismas dos, para el navegador (login de usuarios y portal de tiendas).
# Si faltan, la UI de login degrada con un mensaje en vez de romper el sitio.
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# La service_role **bypassea RLS**: lee y escribe todo el catálogo.
#   - Nunca con prefijo NEXT_PUBLIC_.
#   - Nunca en un archivo commiteado.
#   - Sólo en el entorno del servidor y en la máquina que corre los scrapers.
SUPABASE_SERVICE_ROLE_KEY=

# --- Admin ------------------------------------------------------------------

# **Sin estas dos, el admin no abre.** Es a propósito: antes había valores por
# defecto escritos en el repositorio, así que un deploy al que le faltara una de
# las dos quedaba con contraseña pública y andaba perfecto — la peor combinación.
#
# ADMIN_PASSWORD: 16 caracteres o más. El panel avisa si es corta o previsible.
# ADMIN_SESSION_TOKEN: un valor aleatorio largo, distinto de la contraseña. Es lo
# que se guarda en la cookie; con `openssl rand -hex 32` alcanza.
ADMIN_PASSWORD=
ADMIN_SESSION_TOKEN=

# --- Sitio ------------------------------------------------------------------

# El origen canónico. Gobierna a la vez el canonical de cada página, el sitemap,
# el robots, el JSON-LD, el llms.txt y el redirect de apex → www.
#
# En staging o en un preview, **setearla al origen de ese entorno**. Si no, ese
# entorno se declara a sí mismo como producción y compite en Google con el sitio
# real por el mismo contenido. (El middleware manda `noindex` en cualquier host
# que no sea este, así que el riesgo está acotado — pero mejor los dos.)
NEXT_PUBLIC_SITE_URL=https://www.notebooks.com.ar

# --- Content-Security-Policy ------------------------------------------------

# Sin esto, la CSP sale en modo report-only: informa y no bloquea.
#
# Procedimiento para prenderla: desplegar, mirar los avisos `[csp]` en los logs
# unos días, agregar lo que falte a la lista de `next.config.mjs`, y recién ahí
# poner `true`. No se prende de una: la lista de orígenes que un sitio realmente
# usa no se deduce leyendo el código.
CSP_ENFORCE=false

# --- Caché del catálogo -----------------------------------------------------

# El sitio sirve el catálogo desde caché y lo invalida por aviso, no por TTL. Este
# es el secreto que autentica ese aviso: lo manda el scraper al terminar de
# escribir, y sin él el endpoint contesta 503 y no invalida nada.
#
# Sin la variable el sitio sigue funcionando: los precios nuevos tardan hasta
# cinco minutos en verse (el techo de frescura), en vez de aparecer al instante.
#
#   openssl rand -hex 32
REVALIDATE_SECRET=

# --- Emails (worker de alertas) ---------------------------------------------

RESEND_API_KEY=
# Firma de los links de baja de las alertas. Si cambia, los links ya enviados
# dejan de validar.
UNSUB_SECRET=
